# ──────────────────────────────────
# Intel Platform - Production Config
# For Dokploy deployment
# ──────────────────────────────────

NODE_ENV=production
PORT=4000

# Database (PostgreSQL)
# DB_HOST should be "postgres" when using included docker-compose
DB_HOST=postgres
DB_PORT=5432
DB_USER=intel_admin
DB_PASSWORD=replace_with_strong_password_here
DB_NAME=intel_platform

# JWT Secrets (REQUIRED — generate strong random strings)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_64_byte_random_hex_string
JWT_REFRESH_SECRET=replace_with_64_byte_random_hex_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS
CORS_ORIGIN=*

# File Uploads
MAX_FILE_SIZE=52428800

# Admin Password (used for first-run seed)
ADMIN_PASSWORD=changeme_now

# Seed (set to "true" to populate with demo data on first run)
RUN_SEEDS=false
